---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrivacyPage from '../components/PrivacyPage.astro';
import { getLang, getPage } from '../i18n/utils';
const meta = getPage(getLang(Astro.url.pathname)).privacy.meta;
---

<BaseLayout title={meta.title} description={meta.description}>
  <PrivacyPage />
</BaseLayout>
