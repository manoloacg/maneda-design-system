---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import { getLang, getPage } from '../../i18n/utils';
import { studioSchema } from '../../lib/schema';
const lang = getLang(Astro.url.pathname);
const meta = getPage(lang).home.meta;
---

<BaseLayout title={meta.title} description={meta.description} schema={[studioSchema(lang)]}>
  <HomePage />
</BaseLayout>
