---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProcessPage from '../../components/ProcessPage.astro';
import { getLang, getPage } from '../../i18n/utils';
import { faqSchema } from '../../lib/schema';
const lang = getLang(Astro.url.pathname);
const meta = getPage(lang).process.meta;
---

<BaseLayout title={meta.title} description={meta.description} schema={[faqSchema(getPage(lang).process.faq.items)]}>
  <ProcessPage />
</BaseLayout>
