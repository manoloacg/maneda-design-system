---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/CaseStudy.astro';
import { caseStudySchema } from '../../../lib/schema';
import { hasPlaceholder } from '../../../lib/journal';
import { fill, getLang, getPage, routeFor, withSiteName } from '../../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('projects');
  return all
    .filter((p) => p.id.startsWith('pt/') && p.data.published)
    .map((entry) => ({ params: { slug: entry.id.split('/')[1] }, props: { entry } }));
}
const { entry } = Astro.props;
const lang = getLang(Astro.url.pathname);
const description = fill(getPage(lang).caseStudy.metaDescription, { title: entry.data.title });
const unfinished = hasPlaceholder(entry.data);
// Share image: the project's own hero photo when one is supplied, otherwise the studio default.
const share = entry.data.heroImage ? (await getImage({ src: entry.data.heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src : undefined;
const url = `${routeFor(lang, 'work')}${Astro.params.slug}/`;
---

<BaseLayout image={share} noindex={unfinished} schema={unfinished ? [] : [caseStudySchema(lang, entry.data, url)]} title={withSiteName(entry.data.title)} description={description}>
  <CaseStudy entry={entry} />
</BaseLayout>
