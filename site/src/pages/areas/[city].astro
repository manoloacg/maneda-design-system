---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityPage from '../../components/CityPage.astro';
import { fill, getLang, getPage, withSiteName } from '../../i18n/utils';

export async function getStaticPaths() {
  const all = await getCollection('cities');
  return all
    .filter((c) => c.id.startsWith('en/') && c.data.published)
    .map((entry) => ({ params: { city: entry.id.split('/')[1] }, props: { entry } }));
}
const { entry } = Astro.props;
const lang = getLang(Astro.url.pathname);
const title = fill(getPage(lang).cities.title, { city: entry.data.city });
---

<BaseLayout title={withSiteName(title)} description={entry.data.intro}>
  <CityPage entry={entry} />
</BaseLayout>
