---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServicesPage from '../components/ServicesPage.astro';
import { getLang, getPage } from '../i18n/utils';
import { studioSchema, servicesSchema } from '../lib/schema';
const lang = getLang(Astro.url.pathname);
const meta = getPage(lang).services.meta;
---

<BaseLayout title={meta.title} description={meta.description} schema={[studioSchema(lang), ...servicesSchema(lang)]}>
  <ServicesPage />
</BaseLayout>
