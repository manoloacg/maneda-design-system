---
/* Big image, project type, city-level location, one-line result.
   Without an image it shows a flagged placeholder frame. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import SheetLabel from './SheetLabel.astro';
import { markPlaceholders } from '../i18n/utils';
interface Props {
  href: string;
  number: string;
  type: string;
  location: string;
  result: string;
  title: string;
  image?: ImageMetadata;
  alt?: string;
  as?: 'h2' | 'h3';
}
const { href, number, type, location, result, title, image, alt = '', as: Heading = 'h3' } = Astro.props;
---

<article class="reveal group">
  <a href={href} class="block no-underline">
    <div class="overflow-hidden">
      {
        image ? (
          <Image src={image} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 380px, 100vw" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" loading="lazy" />
        ) : (
          <ImagePlaceholder ratio="4 / 3" note={alt} />
        )
      }
    </div>
    <div class="mt-5 border-t border-[var(--color-rule-strong)] pt-4">
      <SheetLabel text={number} class="mb-3" />
      <Heading class="mb-2 text-[var(--text-h3)]" set:html={markPlaceholders(title)} />
      <p class="sheet-label mb-3 text-[var(--color-text-muted)]">{type} · {location}</p>
      <p class="text-[var(--color-text-muted)]" set:html={markPlaceholders(result)} />
    </div>
  </a>
</article>
