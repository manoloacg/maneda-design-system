---
import Section from './Section.astro';
import Button from './Button.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import SheetLabel from './SheetLabel.astro';
import ZoomImage from './ZoomImage.astro';
import ZoomDialog from './ZoomDialog.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import site from '../content/site.json';
import { getLang, getPage, markPlaceholders, routeFor, t } from '../i18n/utils';

const { entry } = Astro.props;
const d = entry.data;
const lang = getLang(Astro.url.pathname);
const page = getPage(lang);
const c = page.caseStudy;
const S = c.sections;
const show = site.showPlaceholders;
const PH = c.placeholders;
const typeLabel = page.work.filters[d.type as 'residential'];
const facts = ([
  [c.facts.type, typeLabel],
  [c.facts.location, d.location],
  [c.facts.size, d.size],
  [c.facts.scope, d.scope],
  [c.facts.role, d.role],
  [c.facts.year, d.year],
] as [string, string | undefined][]).map(([k, v]) => [k, v ?? (k === c.facts.size && show ? PH.size : undefined)] as [string, string | undefined]).filter(([, v]) => v) as [string, string][];
const sk = d.sketch;
const hasSketch = !!(sk && (sk.earlyImage || sk.finalImage)) || show;
const hasDocs = !!d.documentsImage || show;
let next = 3;
const nextLabel = () => String(++next).padStart(2, '0');
const ph = markPlaceholders;
---

<article>
  <header style="padding-top:var(--section-space)">
    <div class="container-site reveal">
      <p class="mb-6"><a href={routeFor(lang, 'work')} class="sheet-label text-[var(--color-text-muted)]">&larr; {c.back}</a></p>
      <SheetLabel text={d.number} class="mb-6" />
      <h1 class="max-w-[20ch]" set:html={ph(d.title)} />
      <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-6 border-t border-[var(--color-rule-strong)] pt-6 md:grid-cols-3 lg:grid-cols-6">
        {
          facts.map(([k, v]) => (
            <div>
              <dt class="sheet-label mb-2 text-[var(--color-text-muted)]">{k}</dt>
              <dd class="text-sm" set:html={ph(v)} />
            </div>
          ))
        }
      </dl>
    </div>
    <div class="mt-12">
      {
        d.heroImage ? (
          <Image src={d.heroImage} alt={d.heroAlt} widths={[800, 1200, 1800]} sizes="100vw" loading="eager" class="aspect-[21/9] w-full object-cover" />
        ) : (
          <ImagePlaceholder ratio="16 / 9" note={d.heroAlt} />
        )
      }
      {d.heroCaption && <p class="container-site mt-3 text-sm text-[var(--color-text-muted)]">{d.heroCaption}</p>}
    </div>
  </header>

  <Section label="01" title={S.brief} intro={d.brief} />
  <Section tone="alt" label="02" title={S.context} intro={d.context} />

  <Section label="03" title={d.movesTitle ?? S.moves} intro={d.movesIntro ?? S.movesIntro}>
    <ol class="grid gap-16">
      {
        d.moves.map((m: { title: string; text: string; visual?: string; image?: ImageMetadata; alt?: string }, i: number) =>
          m.image || (show && (m.visual || PH.visual)) ? (
            <li class="reveal grid grid-cols-12 items-start md:gap-x-8 gap-y-6">
              <div class={`col-span-12 md:col-span-7 ${i % 2 ? 'md:order-2' : ''}`}>
                {m.image ? (
                  <ZoomImage src={m.image} alt={m.alt ?? ''} widths={[640, 960, 1200]} sizes="(min-width: 768px) 58vw, 100vw" class="aspect-[4/3] w-full object-cover" label={S.zoom} />
                ) : (
                  <ImagePlaceholder ratio="4 / 3" note={m.visual ?? PH.visual} />
                )}
              </div>
              <div class="col-span-12 md:col-span-5">
                <SheetLabel text={String(i + 1).padStart(2, '0')} class="mb-4" />
                <h3 class="mb-4" set:html={ph(m.title)} />
                <p class="text-[var(--color-text-muted)]" set:html={ph(m.text)} />
              </div>
            </li>
          ) : (
            <li class="reveal max-w-[60ch] border-t border-[var(--color-rule-strong)] pt-6">
              <SheetLabel text={String(i + 1).padStart(2, '0')} class="mb-4" />
              <h3 class="mb-4" set:html={ph(m.title)} />
              <p class="text-[var(--color-text-muted)]" set:html={ph(m.text)} />
            </li>
          )
        )
      }
    </ol>
  </Section>

  {
    d.sheets && d.sheets.length > 0 && (
      <Section label={nextLabel()} title={S.sheets} intro={S.sheetsIntro}>
        <ul class="grid items-start gap-8 md:grid-cols-2">
          {d.sheets.map((sh: { image: ImageMetadata; alt: string; caption: string }) => (
            <li class="reveal">
              <figure>
                <ZoomImage src={sh.image} alt={sh.alt} widths={[640, 960, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="h-auto w-full border border-[var(--color-rule)]" label={S.zoom} />
                <figcaption class="sheet-label mt-3 text-[var(--color-text-muted)]">{sh.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  {
    hasSketch && (
      <Section tone="alt" label={nextLabel()} title={S.sketch}>
        <div class="grid gap-8 md:grid-cols-2">
          <figure class="reveal">
            {sk?.earlyImage ? <Image src={sk.earlyImage} alt={sk.earlyAlt ?? ''} widths={[640, 960, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="lazy" /> : <ImagePlaceholder ratio="4 / 3" note={sk?.early ?? PH.sketchEarly} />}
            <figcaption class="sheet-label mt-3 text-[var(--color-text-muted)]">{S.sketchEarly}</figcaption>
          </figure>
          <figure class="reveal">
            {sk?.finalImage ? <Image src={sk.finalImage} alt={sk.finalAlt ?? ''} widths={[640, 960, 1200]} sizes="(min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="lazy" /> : <ImagePlaceholder ratio="4 / 3" note={sk?.final ?? PH.sketchFinal} />}
            <figcaption class="sheet-label mt-3 text-[var(--color-text-muted)]">{S.sketchFinal}</figcaption>
          </figure>
        </div>
      </Section>
    )
  }

  {
    hasDocs && (
      <Section label={nextLabel()} title={d.documentsTitle ?? S.documents} intro={d.documentsIntro ?? S.documentsIntro}>
        <div class={d.documentsImage && d.documentsImage.width / d.documentsImage.height > 1.2 ? 'max-w-[64rem]' : 'max-w-[40rem]'}>
          {d.documentsImage ? <ZoomImage src={d.documentsImage} alt={d.documentsAlt ?? ''} widths={[640, 960, 1200, 1800]} sizes="(min-width: 1024px) 64rem, 100vw" class="w-full" label={S.zoom} /> : <ImagePlaceholder ratio="3 / 2" note={d.documents ?? PH.documents} />}
        </div>
      </Section>
    )
  }

  {(d.outcome || show) && <Section tone="alt" label={nextLabel()} title={S.outcome} intro={d.outcome ?? PH.outcome} />}

  <Section tone="dark" label={t(lang, 'cta.nextStep')} title={c.cta.title} intro={c.cta.text}>
    <Button href={`${routeFor(lang, 'contact')}?service=residential-design`}>{c.cta.button}</Button>
  </Section>
</article>
<ZoomDialog />
