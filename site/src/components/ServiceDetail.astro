---
import Section from './Section.astro';
import Button from './Button.astro';
import ServiceArt from './ServiceArt.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hero from '../assets/hero-home.jpg';
import services from '../content/services.json';
import pricing from '../content/pricing.json';
import { formatUsd, getLang, getPage, pick, routeFor, t } from '../i18n/utils';

interface Props { id: string }
const { id } = Astro.props;
const lang = getLang(Astro.url.pathname);
const full = getPage(lang);
const page = full.services;
const L = page.labels;
const contact = routeFor(lang, 'contact');
const servicesHref = routeFor(lang, 'services');
const quoteHref = (sid: string) => `${contact}?service=${sid}`;
const items = page.items as Record<string, (typeof page.items)['residential-design']>;
const s = services.services.find((x) => x.id === id)!;
const d = items[id];
const i = services.services.findIndex((x) => x.id === id);
const others = services.services.filter((x) => x.id !== id);
const num = (n: number) => String(n + 1).padStart(2, '0');

const custom = import.meta.glob<ImageMetadata>('../assets/services/*.{jpg,jpeg,png,webp}', { eager: true, import: 'default' });
const customFor = (sid: string) => Object.entries(custom).find(([k]) => (k.split('/').pop() ?? '').startsWith(`${sid}.`))?.[1];
const photo = (() => {
  const c = customFor(id);
  if (c) return { src: c, alt: pick(lang, s.title) };
  if (id === 'residential-design') return { src: hero, alt: full.home.hero.alt };
  return undefined;
})();
const isCd = id === 'construction-documents';

const card = 'border border-[var(--color-rule-strong)] bg-[var(--color-bg)] p-6 md:p-7';
const cardTitle = 'sheet-label mb-4 flex items-center gap-3 text-[var(--color-text-muted)]';
const bullet = 'flex gap-3 border-t border-[var(--color-rule)] py-3 first:border-t-0 before:mt-[0.62em] before:h-[5px] before:w-[5px] before:shrink-0 before:bg-gold before:content-[""]';
const bulletNo = "flex gap-3 border-t border-[var(--color-rule)] py-3 first:border-t-0 before:shrink-0 before:text-stone before:content-['×']";
const priceRow = 'flex items-baseline justify-between gap-6 border-t border-[var(--color-rule)] py-3 first:border-t-0';
const priceFig = 'font-[family-name:var(--font-display)] text-[1.6rem] leading-none';
---

<div class="container-site pt-8">
  <a href={servicesHref} class="sheet-label text-[var(--color-text-muted)]">&larr; {L.allServices}</a>
</div>

<section style="padding-block:var(--section-space)">
        <div class="container-site grid grid-cols-12 gap-y-10 lg:gap-x-12">
          <div class="col-span-12 lg:col-span-5">
            <div class="lg:sticky lg:top-[calc(var(--header-h)+2rem)]">
              <div class="mb-6 flex items-end gap-4">
                <span aria-hidden="true" class="font-[family-name:var(--font-display)] text-[5.5rem] font-light leading-[0.8] text-stone">{num(i)}</span>
                <ServiceArt kind={id as 'residential-design'} variant="icon" class="mb-1 h-10 w-10 text-obsidian" />
              </div>
              <div class="reveal">
                {photo ? (
                  <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1000]} sizes="(min-width: 1024px) 40vw, 100vw" class="aspect-[4/3] w-full object-cover" loading="lazy" />
                ) : (
                  <div class="border border-[var(--color-rule-strong)] bg-[var(--color-bg-alt)] p-4 text-obsidian">
                    <ServiceArt kind={id as 'residential-design'} class="h-auto w-full" />
                  </div>
                )}
                {id === 'residential-design' && <p class="mt-3"><a href={routeFor(lang, 'work')} class="sheet-label text-[var(--color-text-muted)]">{L.seeWork} &rarr;</a></p>}
              </div>

              <div class={`reveal mt-6 ${card}`}>
                <p class={cardTitle}>{L.pricing}</p>
                {s.pricing === 'quoted' && (
                  <>
                    <p class="font-medium">{pick(lang, pricing.quoted.label)}</p>
                    <p class="mt-2 text-sm text-[var(--color-text-muted)]">{pick(lang, pricing.quoted.explanation)}</p>
                  </>
                )}
                {s.pricing === 'siteAnalysis' && (
                  <>
                    <ul>
                      {pricing.siteAnalysis.tiers.map((tier) => (
                        <li class={priceRow}><span>{pick(lang, tier.label)}</span><span class={priceFig}>{formatUsd(lang, tier.amount)}</span></li>
                      ))}
                    </ul>
                    <p class="sheet-label mb-1 mt-5 text-[var(--color-text-muted)]">{L.addons}</p>
                    <ul>
                      {pricing.siteAnalysis.addons.map((a) => (
                        <li class={`${priceRow} text-sm`}><span>{pick(lang, a.label)}</span><span>{formatUsd(lang, a.amount)}</span></li>
                      ))}
                    </ul>
                  </>
                )}
                {s.pricing === 'consultations' && (
                  <ul>
                    {pricing.consultations.map((c) => (
                      <li class="border-t border-[var(--color-rule)] py-3 first:border-t-0">
                        <div class="flex items-baseline justify-between gap-6">
                          <span>{pick(lang, c.duration)}</span>
                          <span class={priceFig}>{formatUsd(lang, c.amount)}</span>
                        </div>
                        <p class="mt-1 text-sm text-[var(--color-text-muted)]">{formatUsd(lang, c.credit)} {L.credit}</p>
                      </li>
                    ))}
                  </ul>
                )}
                {isCd && (
                  <>
                    <p class="sheet-label mb-1 mt-5 text-[var(--color-text-muted)]">{L.siteVisitTitle}</p>
                    <div class="border-t border-[var(--color-rule)] pt-3">
                      <div class="flex items-baseline justify-between gap-6">
                        <span>{pick(lang, pricing.siteVisit.label)}</span>
                        <span class={priceFig}>{formatUsd(lang, pricing.siteVisit.amount)}</span>
                      </div>
                      <p class="mt-1 text-sm text-[var(--color-text-muted)]">{formatUsd(lang, pricing.siteVisit.credit)} {L.credit}</p>
                    </div>
                  </>
                )}
              </div>
            </div>
          </div>

          <div class="col-span-12 lg:col-span-7">
            <div class="reveal">
              <p class="sheet-label mb-4 text-[var(--color-text-muted)]">{isCd ? L.cdEyebrow : pick(lang, s.short)}</p>
              <h1>{pick(lang, s.title)}</h1>
              <p class="lead mt-6 max-w-[60ch]">{d.what}</p>
            </div>

            <dl class="reveal mt-10 grid gap-px border border-[var(--color-rule-strong)] bg-[var(--color-rule-strong)] md:grid-cols-2">
              <div class="bg-[var(--color-bg)] p-6">
                <dt class="sheet-label mb-2 text-[var(--color-text-muted)]">{L.suits}</dt>
                <dd>{d.suits}</dd>
              </div>
              <div class="bg-[var(--color-bg)] p-6">
                <dt class="sheet-label mb-2 text-[var(--color-text-muted)]">{L.duration}</dt>
                <dd>{d.duration}</dd>
              </div>
            </dl>

            <div class={`reveal mt-6 ${card}`}>
              <h3 class={cardTitle}>{L.included}</h3>
              <ul>{d.included.map((x) => <li class={bullet}>{x}</li>)}</ul>
            </div>
            <div class="mt-6 grid gap-6 md:grid-cols-2">
              <div class={`reveal ${card}`}>
                <h3 class={cardTitle}>{L.deliverables}</h3>
                <ul>{d.deliverables.map((x) => <li class={bullet}>{x}</li>)}</ul>
              </div>
              <div class={`reveal ${card}`}>
                <h3 class={cardTitle}>{L.notIncluded}</h3>
                <ul>{d.notIncluded.map((x) => <li class={bulletNo}>{x}</li>)}</ul>
              </div>
            </div>

            {isCd && (
              <div class={`reveal mt-6 ${card}`}>
                <h3 class={cardTitle}>{L.sheetIndex}</h3>
                <ol class="grid gap-x-8 sm:grid-cols-2">
                  {page.cdSheets.map((sheet, n) => (
                    <li class="flex gap-4 border-t border-[var(--color-rule)] py-3 first:border-t-0 sm:[&:nth-child(2)]:border-t-0"><span class="sheet-label text-[var(--color-text-muted)]">A-{n + 1}</span>{sheet}</li>
                  ))}
                </ol>
                <p class="mt-5 text-sm text-[var(--color-text-muted)]">{t(lang, 'footer.seal')}</p>
              </div>
            )}

            <p class="mt-10">
              <Button href={quoteHref(id)}>{id === 'consultations' ? L.bookConsultation : L.requestQuote}</Button>
            </p>
          </div>
        </div>
      </section>

<Section tone="alt" label={L.otherServices}>
  <ul class="grid gap-px border border-[var(--color-rule-strong)] bg-[var(--color-rule-strong)] sm:grid-cols-2 lg:grid-cols-4">
    {
      others.map((o) => (
        <li class="bg-[var(--color-bg)]">
          <a href={`${servicesHref}${o.id}/`} class="flex h-full flex-col gap-3 p-6 no-underline transition-colors hover:bg-[var(--color-bg-alt)]">
            <ServiceArt kind={o.id as 'residential-design'} variant="icon" class="h-10 w-10 text-obsidian" />
            <span class="font-[family-name:var(--font-display)] text-[1.4rem] leading-tight">{pick(lang, o.title)}</span>
            <span class="text-sm text-[var(--color-text-muted)]">{pick(lang, o.summary)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
