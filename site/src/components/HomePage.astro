---
import Section from './Section.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import hero from '../assets/hero-home.jpg';
import ProjectCard from './ProjectCard.astro';
import SheetLabel from './SheetLabel.astro';
import ServiceArt from './ServiceArt.astro';
import services from '../content/services.json';
import { getProjects } from '../lib/projects';
import { getLang, getPage, pick, routeFor, t } from '../i18n/utils';

const lang = getLang(Astro.url.pathname);
const p = getPage(lang).home;
const labels = getPage(lang).work.filters;
const contact = routeFor(lang, 'contact');
const projects = (await getProjects(lang)).slice(0, 3);
const num = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="relative">
  <div class="relative">
    <Image
      src={hero}
      alt={p.hero.alt}
      widths={[640, 960, 1440, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/3] w-full object-cover object-[50%_100%] md:aspect-[16/9] xl:aspect-[16/9]"
    />
    <!-- Dark fade behind the headline so the text stays readable on any photo -->
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 hidden h-[75%] bg-[linear-gradient(to_top,rgba(13,13,13,0.94),rgba(13,13,13,0.86)_50%,rgba(13,13,13,0))] xl:block"></div>
  </div>
  <div class="container-site reveal pb-12 pt-10 text-obsidian xl:absolute xl:inset-x-0 xl:bottom-0 xl:pb-14 xl:pt-0 xl:text-ivory xl:[--color-text-muted:var(--ivory)]">
    <h1 class="max-w-[16ch] xl:max-w-[22ch] xl:text-[clamp(2.5rem,1rem+3vw,3.75rem)]">{t(lang, 'home.headline')}</h1>
    <p class="lead mt-6 max-w-[52ch] xl:mt-5 xl:max-w-[110ch] xl:text-[1.1rem]">{t(lang, 'home.subhead')}</p>
    <div class="mt-8 flex flex-wrap gap-4 xl:hidden">
      <Button href={contact}>{t(lang, 'cta.requestQuote')}</Button>
      <Button href={routeFor(lang, 'work')} variant="secondary">{t(lang, 'cta.seeWork')}</Button>
    </div>
    <div class="mt-7 hidden flex-wrap gap-4 xl:flex">
      <Button href={contact}>{t(lang, 'cta.requestQuote')}</Button>
      <Button href={routeFor(lang, 'work')} variant="secondary" tone="dark">{t(lang, 'cta.seeWork')}</Button>
    </div>
  </div>
</section>

<Section label={p.positioning.label} title={p.positioning.title} intro={p.positioning.text} />

<Section tone="alt" label={p.audience.label} title={p.audience.title}>
  <div class="grid gap-10 md:grid-cols-3">
    {
      p.audience.items.map((item, i) => (
        <div class="reveal border-t border-[var(--color-rule-strong)] pt-6">
          <SheetLabel text={num(i)} class="mb-4" />
          <h3 class="mb-4">{item.title}</h3>
          <p class="text-[var(--color-text-muted)]">{item.text}</p>
          {'link' in item && (
            <p class="mt-4"><Button href={`${routeFor(lang, 'services')}#builders`} variant="text">{item.link}</Button></p>
          )}
        </div>
      ))
    }
  </div>
</Section>

<Section label={p.services.label} title={p.services.title}>
  <ol class="border-t border-[var(--color-rule-strong)]">
    {
      services.services.map((s, i) => (
        <li class="reveal grid grid-cols-12 items-baseline gap-x-6 gap-y-2 border-b border-[var(--color-rule)] py-7">
          <span class="col-span-2 flex items-center gap-3 md:col-span-1">
            <span class="sheet-label text-[var(--color-text-muted)]">{num(i)}</span>
          </span>
          <h3 class="col-span-10 flex items-center gap-4 md:col-span-4">
            <ServiceArt kind={s.id as 'residential-design'} variant="icon" class="h-9 w-9 shrink-0 text-obsidian" />
            <span>{pick(lang, s.title)}</span>
          </h3>
          <p class="col-span-12 text-[var(--color-text-muted)] md:col-span-5">{pick(lang, s.summary)}</p>
          <p class="col-span-12 md:col-span-2 md:text-right">
            <Button href={`${routeFor(lang, 'services')}#${s.id}`} variant="text">{p.services.learnMore}<span class="sr-only">&nbsp;{p.services.learnMoreAbout} {pick(lang, s.title)}</span></Button>
          </p>
        </li>
      ))
    }
  </ol>
</Section>

<Section tone="alt" label={p.work.label} title={p.work.title}>
  <div class="grid gap-10 md:grid-cols-3">
    {
      projects.map((pr) => (
        <ProjectCard
          href={`${routeFor(lang, 'work')}${pr.slug}/`}
          number={pr.data.number}
          title={pr.data.title}
          type={labels[pr.data.type]}
          location={pr.data.location}
          result={pr.data.result}
          alt={pr.data.heroAlt}
          image={pr.data.cardImage ?? pr.data.heroImage}
        />
      ))
    }
  </div>
  <p class="mt-12"><Button href={routeFor(lang, 'work')} variant="secondary">{p.work.viewAll}</Button></p>
</Section>

<Section label={p.process.label} title={p.process.title}>
  <ol class="grid gap-8 md:grid-cols-5">
    {
      p.process.steps.map((s, i) => (
        <li class="reveal border-t border-[var(--color-rule-strong)] pt-5">
          <SheetLabel text={num(i)} rule={false} class="mb-3" />
          <h3 class="mb-3 text-[1.35rem]">{s.title}</h3>
          <p class="text-sm text-[var(--color-text-muted)]">{s.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="mt-12"><Button href={routeFor(lang, 'process')} variant="text">{p.process.link}</Button></p>
</Section>

<Section tone="dark" label={p.credibility.label} title={p.credibility.title}>
  <dl class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      p.credibility.items.map((c) => (
        <div class="reveal border-t border-[var(--color-rule)] pt-5">
          <dt class="font-[family-name:var(--font-display)] text-[var(--text-h2)] font-light leading-none text-gold">{c.k}</dt>
          <dd class="mt-4 text-[var(--color-text-muted)]">{c.v}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<Section tone="alt" label={p.cta.label} title={p.cta.title} intro={p.cta.text}>
  <div class="grid grid-cols-12 gap-6">
    <ul class="col-span-12 border-t border-[var(--color-rule-strong)] md:col-span-6">
      {p.cta.fields.map((f) => <li class="border-b border-[var(--color-rule)] py-4 text-[var(--color-text-muted)]">{f}</li>)}
    </ul>
    <div class="col-span-12 md:col-span-6 md:self-end md:text-right">
      <Button href={contact}>{t(lang, 'cta.requestQuote')}</Button>
    </div>
  </div>
</Section>
