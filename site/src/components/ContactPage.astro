---
import Section from './Section.astro';
import Button from './Button.astro';
import FormField from './FormField.astro';
import Slot from './Slot.astro';
import { slotVisible } from '../lib/slots';
import site from '../content/site.json';
import { fill, getLang, getPage, isPlaceholder, markPlaceholders, pick, routeFor } from '../i18n/utils';

const lang = getLang(Astro.url.pathname);
const page = getPage(lang).contact;
const F = page.form;
const reply = pick(lang, site.replyWindow);
const testMode = isPlaceholder(site.form.accessKey);
const email = site.email;
const link = 'underline decoration-gold';
---

<section style="padding-top:var(--section-space)">
  <div class="container-site reveal">
    <p class="sheet-label mb-5 text-[var(--color-text-muted)]">{page.hero.label}</p>
    <h1>{page.hero.title}</h1>
    <p class="lead mt-6 max-w-[60ch]" set:html={markPlaceholders(fill(page.hero.intro, { replyWindow: reply }))} />
  </div>
</section>

<section style="padding-block:clamp(3rem, 2rem + 4vw, 6rem) var(--section-space)">
  <div class="container-site grid grid-cols-12 md:gap-x-10 gap-y-12">
    <form
      id="inquiry"
      class="col-span-12 grid min-w-0 grid-cols-1 gap-5 md:col-span-8 md:grid-cols-2"
      method="post"
      action={site.form.endpoint}
      novalidate
      data-endpoint={site.form.endpoint}
      data-thanks={routeFor(lang, 'thankYou')}
      data-test={String(testMode)}
      data-required={F.errorRequired}
      data-email={F.errorEmail}
      data-send={F.errorSend}
      data-fix={F.fixErrors}
      data-sending={F.sending}
    >
      <input type="hidden" name="access_key" value={site.form.accessKey} />
      <input type="hidden" name="subject" value="New inquiry from the Maneda Design Studios website" />
      <input type="hidden" name="from_name" value="Maneda Design Studios website" />
      <input type="hidden" name="page_language" value={lang} />
      <!-- Spam trap: people never see or tick this. Web3Forms rejects submissions where it is checked. -->
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

      <FormField name="name" label={F.name} required autocomplete="name" />
      <FormField name="email" label={F.email} type="email" required autocomplete="email" />
      <FormField name="phone" label={F.phone} type="tel" autocomplete="tel" />
      <FormField name="language" label={F.language} type="select" options={F.languageOptions} value={lang} required />
      <FormField name="who" label={F.who} type="select" options={F.whoOptions} emptyLabel={F.choose} required />
      <FormField name="service" label={F.service} type="select" options={F.serviceOptions} value="not-sure" />
      <FormField name="projectType" label={F.projectType} type="select" options={F.projectTypeOptions} emptyLabel={F.choose} required />
      <FormField name="city" label={F.city} required autocomplete="address-level2" />
      <FormField name="size" label={F.size} inputmode="numeric" />
      <FormField name="start" label={F.start} type="select" options={F.startOptions} emptyLabel={F.choose} />
      <FormField name="budget" label={F.budget} type="select" options={F.budgetOptions} emptyLabel={F.choose} />
      <FormField name="heard" label={F.heard} type="select" options={F.heardOptions} emptyLabel={F.choose} />
      <div class="md:col-span-2">
        <FormField name="description" label={F.description} type="textarea" hint={F.descriptionHint} required rows={6} />
      </div>
      <div class="md:col-span-2">
        <FormField name="files" label={F.files} type="url" hint={F.filesHint} inputmode="url" />
      </div>
      <div class="md:col-span-2">
        <p data-status class="mb-4 min-h-[1.5rem] text-[#9B1C1C]" role="alert"></p>
        <Button type="submit">{F.submit}</Button>
      </div>
    </form>

    <aside class="col-span-12 md:col-span-4">
      {slotVisible('contact-side') && <div class="mb-8"><Slot id="contact-side" ratio="4 / 3" sizes="(min-width: 768px) 30vw, 100vw" /></div>}
      <div class="border-t border-[var(--color-rule-strong)] pt-6">
        <p class="sheet-label mb-2 text-[var(--color-text-muted)]">{page.side.email}</p>
        <p class="mb-8">
          {isPlaceholder(email) ? <span set:html={markPlaceholders(email)} /> : <a href={`mailto:${email}`} class={`${link} [overflow-wrap:anywhere]`}>{email}</a>}
        </p>
        <p class="sheet-label mb-2 text-[var(--color-text-muted)]">{page.side.area}</p>
        <p class="mb-8">{pick(lang, site.serviceArea)}</p>
        {
          site.social.instagram && (
            <>
              <p class="sheet-label mb-2 text-[var(--color-text-muted)]">{page.side.social}</p>
              <p class="mb-8"><a href={site.social.instagram} class={link} rel="noopener">Instagram</a></p>
            </>
          )
        }
        {site.booking?.url && <p class="mb-8"><a href={site.booking.url} class={link} rel="noopener">{getPage(lang).home.start.bookCall}</a></p>}
        <p class="text-sm text-[var(--color-text-muted)]">{page.side.note}</p>
      </div>
    </aside>
  </div>
</section>

<script>
  import { initForm } from '../lib/form';
  const form = document.getElementById('inquiry') as HTMLFormElement;

  // Pre-select the service or audience when the visitor arrives from a "Request a quote" button.
  const params = new URLSearchParams(location.search);
  for (const [key, id] of [['service', 'f-service'], ['who', 'f-who']] as const) {
    const wanted = params.get(key);
    const el = document.getElementById(id) as HTMLSelectElement | null;
    if (wanted && el && [...el.options].some((o) => o.value === wanted)) el.value = wanted;
  }
  initForm(form);
</script>
