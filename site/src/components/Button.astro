---
/* variant: primary (gold fill, the one accent button), secondary (outline), text (link style)
   tone: light (default) or dark, for use on dark sections */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  tone?: 'light' | 'dark';
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', tone = 'light', type = 'button', class: extra = '', ...rest } = Astro.props;

const base =
  'inline-flex items-center justify-center min-h-[var(--tap)] px-7 py-3 text-[0.8rem] font-medium uppercase tracking-[0.18em] no-underline transition-colors duration-200 cursor-pointer';
const variants = {
  primary: 'bg-gold text-obsidian hover:bg-gold-light active:bg-gold-dark',
  secondary:
    tone === 'dark'
      ? 'border border-ivory text-ivory hover:bg-ivory hover:text-obsidian'
      : 'border border-obsidian text-obsidian hover:bg-obsidian hover:text-ivory',
  text: 'px-0 underline decoration-gold decoration-1 underline-offset-[0.4em] hover:decoration-2',
};
const classes = `${base} ${variants[variant]} ${extra}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
