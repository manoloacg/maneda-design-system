---
import Section from './Section.astro';
import Button from './Button.astro';
import FormField from './FormField.astro';
import Faq from './Faq.astro';
import ProjectCard from './ProjectCard.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import SheetLabel from './SheetLabel.astro';
import { getLang, markPlaceholders, t } from '../i18n/utils';
const lang = getLang(Astro.url.pathname);
const pt = lang === 'pt';

const swatches = [
  ['Obsidian', '#0D0D0D', 'Text, dark sections'],
  ['Charcoal', '#1A1A1A', 'Dark cards'],
  ['Graphite', '#2C2C2C', 'Strong rules, borders'],
  ['Slate', '#4A4A4A', 'Secondary text'],
  ['Stone', '#7A7A7A', 'Large text only'],
  ['Mist', '#B8B0A8', 'Body text on dark'],
  ['Linen', '#E8E2DA', 'Light rules'],
  ['Ivory', '#F5F2ED', 'Alt background, text on dark'],
  ['Warm White', '#FAFAF8', 'Page background'],
  ['Gold', '#C4A882', 'Accent: rules, button fill'],
  ['Gold Light', '#D4BC9E', 'Hover'],
  ['Gold Dark', '#A88B62', 'Pressed'],
];
const faq = pt
  ? [
      { q: 'Quem sela os desenhos?', a: 'Quando um selo é exigido, os desenhos são revisados e selados por um profissional licenciado responsável pelo projeto.' },
      { q: 'Quanto tempo leva o início?', a: '[PLACEHOLDER: prazo típico, confirmar com o Manolo]' },
    ]
  : [
      { q: 'Who seals the drawings?', a: 'Where a seal is required, drawings are reviewed and sealed by a licensed professional of record.' },
      { q: 'How long until we start?', a: '[PLACEHOLDER: typical lead time, confirm with Manolo]' },
    ];
const options = pt
  ? [{ value: 'pt', label: 'Português' }, { value: 'en', label: 'English' }]
  : [{ value: 'en', label: 'English' }, { value: 'pt', label: 'Português' }];
---

<Section titleTag="h1" label="MDS-26-SG" title={t(lang, 'styleguide.title')} intro={t(lang, 'styleguide.intro')} />

<Section label="01" title={t(lang, 'styleguide.colors')} tone="alt">
  <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
    {
      swatches.map(([name, hex, role]) => (
        <div class="reveal">
          <div class="h-24 border border-[var(--color-rule-strong)]" style={`background:${hex}`}></div>
          <p class="mt-2 font-medium">{name}</p>
          <p class="sheet-label text-[var(--color-text-muted)]">{hex}</p>
          <p class="text-sm text-[var(--color-text-muted)]">{role}</p>
        </div>
      ))
    }
  </div>
  <p class="mt-10 max-w-[65ch] text-[var(--color-text-muted)]">
    {pt ? 'Ouro nunca é cor de texto sobre fundo claro. Serve para linhas, bordas e o botão principal.' : 'Gold is never a text color on a light background. It is for rules, borders, and the primary button.'}
  </p>
</Section>

<Section label="02" title={t(lang, 'styleguide.type')}>
  <div class="grid gap-10 md:grid-cols-2">
    <div class="reveal">
      <SheetLabel text="Cormorant Garamond 300 / 400" />
      <p class="mt-4 font-[family-name:var(--font-display)] text-[length:var(--text-h1)] font-light leading-[1.1]">{pt ? 'Projeto residencial' : 'Residential design'}</p>
      <h2 class="mt-6">{pt ? 'Decisões de projeto' : 'Design decisions'}</h2>
      <h3 class="mt-6">{pt ? 'Sol, ventilação e implantação' : 'Light, air, and placement'}</h3>
    </div>
    <div class="reveal">
      <SheetLabel text="Montserrat 400 / 500" />
      <p class="lead mt-4">
        {pt ? 'Texto de abertura. Frases curtas, substantivos concretos, sem adjetivos vazios.' : 'Lead text. Short sentences, concrete nouns, no empty adjectives.'}
      </p>
      <p class="mt-4">
        {pt ? 'Texto corrido a 16 pixels, entrelinha 1,7. Legível no celular, sem esforço.' : 'Body text at 16 pixels, line height 1.7. Readable on a phone without effort.'}
      </p>
      <p class="sheet-label mt-4">{pt ? 'Rótulo em caixa alta' : 'Uppercase label'} · MDS-26-01</p>
      <p class="mt-4"><a href="#main">{pt ? 'Link com sublinhado em ouro' : 'Link with gold underline'}</a></p>
    </div>
  </div>
</Section>

<Section label="03" title={t(lang, 'styleguide.buttons')} tone="alt">
  <div class="flex flex-wrap items-center gap-4">
    <Button href="#main">{t(lang, 'cta.requestQuote')}</Button>
    <Button href="#main" variant="secondary">{t(lang, 'cta.seeWork')}</Button>
    <Button href="#main" variant="text">{t(lang, 'cta.nextStep')}</Button>
  </div>
  <div class="tone-dark mt-8 flex flex-wrap items-center gap-4 p-8">
    <Button href="#main">{t(lang, 'cta.requestQuote')}</Button>
    <Button href="#main" variant="secondary" tone="dark">{t(lang, 'cta.seeWork')}</Button>
    <Button href="#main" variant="text">{t(lang, 'cta.nextStep')}</Button>
  </div>
</Section>

<Section label="04" title={t(lang, 'styleguide.form')}>
  <form class="grid max-w-[40rem] gap-5" onsubmit="return false">
    <FormField name="sg-name" label={pt ? 'Nome' : 'Name'} required autocomplete="name" />
    <FormField name="sg-email" label="Email" type="email" required autocomplete="email" />
    <FormField name="sg-lang" label={pt ? 'Idioma de preferência' : 'Language preference'} type="select" options={options} value={lang} required />
    <FormField name="sg-desc" label={pt ? 'Descrição do projeto' : 'Project description'} type="textarea" hint={pt ? 'Tipo de projeto, cidade e prazo desejado.' : 'Project type, city, and target start.'} />
    <div><Button type="submit">{t(lang, 'form.send')}</Button></div>
  </form>
</Section>

<Section label="05" title={t(lang, 'styleguide.cards')} tone="alt">
  <div class="grid gap-10 md:grid-cols-3">
    <ProjectCard
      href="#main"
      number="MDS-26-01"
      title="Barndominium"
      type={pt ? 'Residencial' : 'Residential'}
      location="Orlando, FL"
      result="[PLACEHOLDER: one-line result]"
      alt={pt ? 'Imagem do projeto a ser enviada' : 'Project image to be supplied'}
    />
  </div>
</Section>

<Section label="06" title={t(lang, 'styleguide.faq')}>
  <Faq items={faq} />
</Section>

<Section label="07" title={t(lang, 'styleguide.placeholders')} tone="alt">
  <div class="grid gap-8 md:grid-cols-2">
    <ImagePlaceholder ratio="16 / 9" note="Full-bleed project photo goes here" />
    <p class="lead" set:html={markPlaceholders('Text that still needs real content looks like this: [PLACEHOLDER: replace with real content]')} />
  </div>
</Section>

<Section label="08" title={t(lang, 'styleguide.sections')} tone="dark">
  <p class="lead max-w-[60ch]">{pt ? 'Seções escuras usam obsidiana, marfim e névoa. O padrão do site é claro.' : 'Dark sections use obsidian, ivory, and mist. The site default is light.'}</p>
</Section>
