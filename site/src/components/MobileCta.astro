---
/* Sticky "Request a quote" bar on phones. Hidden on the contact page itself. */
import Button from './Button.astro';
import { getLang, routeFor, t } from '../i18n/utils';
const lang = getLang(Astro.url.pathname);
const contact = routeFor(lang, 'contact');
const hidden = Astro.url.pathname === contact;
---

{
  !hidden && (
    <div class="fixed inset-x-0 bottom-0 z-40 border-t border-[var(--color-rule)] bg-[var(--color-bg)] p-2 md:hidden">
      <Button href={contact} class="w-full">{t(lang, 'cta.requestQuote')}</Button>
    </div>
  )
}
